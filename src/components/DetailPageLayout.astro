---
interface Props {
  title: string;
  backHref: string;
  backLabel: string;
}

const { title, backHref, backLabel } = Astro.props;
const hasActions = Astro.slots.has('actions');
const hasMeta = Astro.slots.has('meta');
const hasLede = Astro.slots.has('lede');
const hasFooter = Astro.slots.has('footer');
const hasOutline = Astro.slots.has('outline');
---

<article class="detail-page">
  <div
    class:list={[
      'container',
      'detail-page__layout',
      { 'detail-page__layout--with-outline': hasOutline },
    ]}
  >
    <header class="detail-page__header">
      <div
        class:list={[
          'detail-page__tools',
          { 'detail-page__tools--two-row': hasMeta && hasActions },
        ]}
      >
        <a href={backHref} class="detail-page__back">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M16 10H5M9 6l-4 4 4 4" />
          </svg>
          {backLabel}
        </a>

        {hasMeta && (
          <div class="detail-page__meta">
            <slot name="meta" />
          </div>
        )}

        {hasActions && (
          <div class="detail-page__actions">
            <slot name="actions" />
          </div>
        )}
      </div>

      <h1 class="detail-page__title">{title}</h1>

      {hasLede && (
        <div class="detail-page__lede">
          <slot name="lede" />
        </div>
      )}
    </header>

    {hasOutline && (
      <div class="detail-page__outline">
        <slot name="outline" />
      </div>
    )}

    <div class="detail-page__body prose">
      <slot />
    </div>

    {hasFooter && (
      <footer class="detail-page__footer">
        <slot name="footer" />
      </footer>
    )}
  </div>
</article>

<style lang="scss">
  .detail-page {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .detail-page__header,
  .detail-page__body,
  .detail-page__footer {
    max-width: var(--max-width-prose);
    margin-inline: auto;
  }

  .detail-page__header {
    margin-bottom: var(--space-10);
  }

  .detail-page__layout--with-outline .detail-page__body {
    :global(:is(h2, h3, h4)[id]) {
      scroll-margin-top: 6rem;
    }
  }

  /* Wide screens: the article stays centred between two equal gutters and the
     outline lives in the left one, spanning the whole article so it sits
     beside the title on load and follows the reader to the end. The layout
     drops the container's max-width so the gutters are wide enough for it.
     The breakpoint must match DocumentOutline.astro. */
  @media (min-width: 1340px) {
    .detail-page__layout--with-outline {
      max-width: none;
      display: grid;
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, var(--max-width-prose))
        minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: clamp(var(--space-10), 3vw, var(--space-16));

      /* Auto margins would shrink grid items to fit their content. */
      > * {
        min-width: 0;
        margin-inline: 0;
      }

      .detail-page__header {
        grid-area: 1 / 2;
      }

      .detail-page__body {
        grid-area: 2 / 2;
      }

      .detail-page__footer {
        grid-area: 3 / 2;
      }
    }

    .detail-page__outline {
      grid-column: 1;
      grid-row: 1 / -1;
      justify-self: end;
      width: 100%;
      max-width: 15rem;
    }
  }

  /* Back link, then meta beneath it. Actions sit in a column of their own,
     centred against both rows so they are level with each. */
  .detail-page__tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-4);
    row-gap: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .detail-page__back {
    grid-area: 1 / 1;
    justify-self: start;
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    text-decoration: none;

    svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: var(--color-accent-primary);
      stroke-width: 1.5;
      transition: transform var(--transition-fast);
    }

    &:hover {
      color: var(--color-text-primary);
      text-decoration: none;

      svg {
        transform: translateX(-0.2rem);
      }
    }
  }

  .detail-page__actions {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  /* With a meta row present, the actions straddle both rows so they read as
     level with the back link and the meta alike. */
  .detail-page__tools--two-row .detail-page__actions {
    grid-row: 1 / span 2;
  }

  .detail-page__meta {
    grid-area: 2 / 1;
    min-height: 1.5rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);

    :global(.detail-meta__date) {
      font-weight: 600;
      color: var(--color-accent-primary);
    }

    :global(.detail-meta__separator) {
      width: 1.5rem;
      height: 1px;
      background: var(--color-border);
    }

    :global(.detail-tag) {
      display: inline-flex;
      align-items: center;
      min-height: 1.5rem;
      padding-left: var(--space-3);
      border-left: 2px solid var(--color-accent-primary);
      font-weight: 600;
      color: var(--color-accent-primary);
    }
  }

  .detail-page__title {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3.1rem, 6.75vw, 6.25rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .detail-page__lede {
    max-width: 48rem;
    margin-top: var(--space-6);

    :global(p) {
      margin: 0;
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      line-height: 1.65;
      color: var(--color-text-secondary);
    }

    :global(mark) {
      background: transparent;
      color: var(--color-accent-primary);
      font-weight: 600;
    }
  }

  .detail-page__footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);

    :global(.detail-action) {
      min-height: 3rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      padding: 0.25rem var(--space-5);
      border: 1px solid var(--color-border);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      text-decoration: none;
      transition:
        color var(--transition-fast),
        background var(--transition-fast),
        border-color var(--transition-fast);
    }

    :global(.detail-action svg) {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: var(--color-accent-primary);
      stroke-width: 1.5;
    }

    :global(.detail-action:hover) {
      color: var(--color-text-primary);
      background: var(--color-bg-hover);
      border-color: var(--color-accent-primary);
      text-decoration: none;
    }

    :global(.detail-pager) {
      display: flex;
      justify-content: space-between;
      gap: var(--space-6);
    }

    :global(.detail-pager__link) {
      min-width: 0;
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-5);
      border: 1px solid var(--color-border);
      color: inherit;
      text-decoration: none;
      transition:
        background var(--transition-fast),
        border-color var(--transition-fast);
    }

    :global(.detail-pager__link:hover) {
      background: var(--color-bg-hover);
      border-color: var(--color-accent-primary);
      text-decoration: none;
    }

    :global(.detail-pager__link--next) {
      align-items: flex-end;
      margin-left: auto;
      text-align: right;
    }

    :global(.detail-pager__label) {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-tertiary);
    }

    :global(.detail-pager__label svg) {
      width: 0.9rem;
      height: 0.9rem;
      fill: none;
      stroke: var(--color-accent-primary);
      stroke-width: 1.5;
    }

    :global(.detail-pager__title) {
      font-weight: 500;
      color: var(--color-text-primary);
    }
  }

  @media (max-width: 768px) {
    .detail-page__title {
      font-size: clamp(2.75rem, 12.5vw, 4.4rem);
    }
  }

  @media (max-width: 640px) {
    .detail-page__footer :global(.detail-pager) {
      flex-direction: column;
    }

    .detail-page__footer :global(.detail-pager__link) {
      width: 100%;
    }
  }
</style>
