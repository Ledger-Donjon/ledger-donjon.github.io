---
interface Props {
  title: string;
  subtitle?: string;
  size?: 'sm' | 'lg';
}

const { title, subtitle, size = 'lg' } = Astro.props;
---

<section class:list={['hero', `hero--${size}`]}>
  <div class="hero__container">
    <div class="hero__content">
      <h1 class="hero__title">{title}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}
      <slot />
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-primary);
    
    &--lg {
      padding: clamp(5rem, 10vw, 9rem) 0 clamp(4rem, 8vw, 7rem);
    }
    
    &--sm {
      padding: clamp(3.75rem, 7vw, 6.5rem) 0 clamp(3.5rem, 6vw, 5.5rem);
    }
    
    &__container {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 var(--space-6);
      position: relative;
      z-index: 1;

      @media (max-width: 720px) {
        padding-inline: var(--space-4);
      }
    }

    &__content {
      max-width: 1000px;
      animation: hero-enter 650ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
    }
    
    &__title {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(4rem, 8vw, 8.5rem);
      font-weight: 500;
      letter-spacing: -0.07em;
      line-height: 0.92;
      text-wrap: balance;
    }
    
    &--sm &__title {
      font-size: clamp(3.5rem, 6.5vw, 6.75rem);
    }
    
    &__subtitle {
      max-width: 700px;
      margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
      font-size: clamp(1.05rem, 1.5vw, 1.3rem);
      color: var(--color-text-lede);
      line-height: 1.6;
      
      @media (max-width: 720px) {
        font-size: var(--text-base);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content {
      animation: none;
    }
  }
</style>
