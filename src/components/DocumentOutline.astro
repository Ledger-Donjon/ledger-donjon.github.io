---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  minDepth?: number;
  maxDepth?: number;
}

interface OutlineItem extends MarkdownHeading {
  children: OutlineItem[];
}

const { headings, minDepth = 2, maxDepth = 3 } = Astro.props;

// GFM footnotes add a visually hidden "Footnotes" heading.
const hiddenSlugs = new Set(['footnote-label']);

const items: OutlineItem[] = [];
for (const heading of headings) {
  if (heading.depth < minDepth || heading.depth > maxDepth) continue;
  if (hiddenSlugs.has(heading.slug)) continue;

  const item: OutlineItem = { ...heading, children: [] };
  const parent = items.at(-1);
  if (parent && heading.depth > parent.depth) {
    parent.children.push(item);
  } else {
    items.push(item);
  }
}
---

{items.length > 0 && (
  <nav class="outline" aria-labelledby="outline-title" data-outline>
    <button
      class="outline__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="outline-panel"
      data-outline-toggle
    >
      <span class="outline__toggle-label">Contents</span>
      <svg class="outline__toggle-icon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M5 8l5 5 5-5" />
      </svg>
    </button>

    <div class="outline__panel" id="outline-panel">
      <p class="outline__title" id="outline-title">On this page</p>
      <ol class="outline__list">
        {items.map((item) => (
          <li>
            <a class="outline__link" href={`#${item.slug}`} data-outline-link>
              {item.text}
            </a>
            {item.children.length > 0 && (
              <ol class="outline__list outline__list--nested">
                {item.children.map((child) => (
                  <li>
                    <a
                      class="outline__link outline__link--nested"
                      href={`#${child.slug}`}
                      data-outline-link
                    >
                      {child.text}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<style lang="scss">
  /* Must match the height of the sticky site header (see Header.astro). */
  .outline {
    --outline-sticky-top: calc(4.1rem + 1px);
  }

  .outline__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .outline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-border);
    color: inherit;

    li {
      margin: 0;
      padding: 0;
    }
  }

  .outline__list--nested {
    border-left: none;
  }

  .outline__link {
    display: block;
    margin-left: -1px;
    padding: 0.4rem 0 0.4rem var(--space-4);
    border-left: 1px solid transparent;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);

    &:hover {
      color: var(--color-text-primary);
      text-decoration: none;
    }

    &[aria-current] {
      color: var(--color-text-primary);
      border-left-color: var(--color-accent-primary);
    }
  }

  .outline__link--nested {
    padding-left: var(--space-8);
    font-size: 0.8125rem;
  }

  .outline__toggle {
    display: none;
  }

  /* Narrow screens: a collapsible block between the lede and the article that
     expands in place, pushing the article down. Without JS the list renders
     expanded. */
  @media (width < 1340px) {
    .outline {
      max-width: var(--max-width-prose);
      margin: 0 auto var(--space-8);
    }

    .outline:not([data-enhanced]) .outline__panel {
      padding: var(--space-5);
      border: 1px solid var(--color-border);
      background: var(--color-bg-secondary);
    }

    .outline[data-enhanced] {
      border: 1px solid var(--color-border);
      background: var(--color-bg-secondary);
      transition: border-color var(--transition-fast);

      &:hover,
      &[data-open] {
        border-color: var(--color-border-hover);
      }

      .outline__toggle {
        width: 100%;
        min-height: 3rem;
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: 0.25rem var(--space-4);
        border: none;
        background: transparent;
        color: var(--color-text-primary);
        font: inherit;
        text-align: left;
        cursor: pointer;
      }

      .outline__panel {
        display: none;
        padding: var(--space-4) var(--space-4) var(--space-5);
        border-top: 1px solid var(--color-border);
      }

      .outline__title {
        display: none;
      }
    }

    .outline[data-open] .outline__panel {
      display: block;
    }
  }

  .outline__toggle-label {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .outline__toggle-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-left: auto;
    fill: none;
    stroke: var(--color-accent-primary);
    stroke-width: 1.5;
    transition: transform var(--transition-fast);
  }

  .outline[data-open] .outline__toggle-icon {
    transform: rotate(180deg);
  }

  /* Wide screens: a sidebar that stays pinned under the site header for the
     whole article. The breakpoint must match DetailPageLayout.astro. */
  @media (min-width: 1340px) {
    .outline {
      position: sticky;
      top: calc(var(--outline-sticky-top) + var(--space-8));
    }

    .outline__panel {
      position: relative;
      max-height: calc(100vh - var(--outline-sticky-top) - var(--space-16));
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media print {
    .outline {
      display: none;
    }
  }
</style>

<script>
  const outline = document.querySelector<HTMLElement>('[data-outline]');
  const toggle = outline?.querySelector<HTMLButtonElement>('[data-outline-toggle]');
  const panel = outline?.querySelector<HTMLElement>('.outline__panel');

  if (outline && toggle && panel) {
    const sections = Array.from(
      outline.querySelectorAll<HTMLAnchorElement>('[data-outline-link]')
    ).flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });

    outline.dataset.enhanced = '';

    let activeLink: HTMLAnchorElement | undefined;

    const revealInPanel = (link: HTMLAnchorElement) => {
      if (panel.scrollHeight <= panel.clientHeight) return;

      const padding = 16;
      const top = link.offsetTop;
      const bottom = top + link.offsetHeight;
      if (top < panel.scrollTop + padding) {
        panel.scrollTop = top - padding;
      } else if (bottom > panel.scrollTop + panel.clientHeight - padding) {
        panel.scrollTop = bottom - panel.clientHeight + padding;
      }
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      outline.toggleAttribute('data-open', open);
      if (open && activeLink) revealInPanel(activeLink);
    };

    const updateActive = () => {
      if (sections.length === 0) return;

      // Use the headings' own scroll margin so a section counts as active
      // exactly when jumping to it from the outline.
      const threshold =
        parseFloat(getComputedStyle(sections[0].heading).scrollMarginTop) + 8;
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

      let active = atBottom ? sections.at(-1) : undefined;
      if (!active) {
        for (const section of sections) {
          if (section.heading.getBoundingClientRect().top > threshold) break;
          active = section;
        }
      }

      if (active?.link === activeLink) return;

      activeLink?.removeAttribute('aria-current');
      activeLink = active?.link;

      if (activeLink) {
        activeLink.setAttribute('aria-current', 'location');
        revealInPanel(activeLink);
      }
    };

    let frame = 0;
    const scheduleUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        updateActive();
      });
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    for (const { link } of sections) {
      link.addEventListener('click', () => setOpen(false));
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    updateActive();
  }
</script>
