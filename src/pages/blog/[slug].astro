---
import Base from '../../layouts/Base.astro';
import DetailPageLayout from '../../components/DetailPageLayout.astro';
import ArticleThemeToggle from '../../components/ArticleThemeToggle.astro';
import DocumentOutline from '../../components/DocumentOutline.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  const includeDrafts = !import.meta.env.PROD;

  return entries
    .filter((entry) => includeDrafts || !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.md$/, '') },
      props: { entry },
    }));
}

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const resolveSocialImage = (img?: string) =>
  img && (/^https?:\/\//.test(img) ? img : withBase(img));

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.date);
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt}
  image={resolveSocialImage(entry.data.image)}
  enableArticleTheme
>
  <DetailPageLayout
    title={entry.data.title}
    backHref={withBase('/blog/')}
    backLabel="All blog posts"
  >
    <ArticleThemeToggle slot="actions" />

    <Fragment slot="meta">
      <time class="detail-meta__date" datetime={entry.data.date.toISOString()}>
        {formattedDate}
      </time>
      <span class="detail-meta__separator" aria-hidden="true"></span>
      <span>Donjon blog</span>
    </Fragment>

    <Fragment slot="lede">
      <p set:html={entry.data.excerpt} />
    </Fragment>

    <DocumentOutline slot="outline" headings={headings} />

    <Content />

    <Fragment slot="footer">
      <a href={withBase('/blog/')} class="detail-action">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16 10H5M9 6l-4 4 4 4" />
        </svg>
        All blog posts
      </a>
    </Fragment>
  </DetailPageLayout>
</Base>

<script>
  // Abstract section wrapper
  const prose = document.querySelector('.detail-page__body.prose');
  if (prose) {
    const headings = prose.querySelectorAll('h2');
    for (const h2 of headings) {
      if (h2.textContent?.trim() !== 'Abstract') continue;
      const wrapper = document.createElement('section');
      wrapper.className = 'abstract';
      h2.before(wrapper);
      wrapper.appendChild(h2);
      while (wrapper.nextElementSibling && !/^H[1-6]$/.test(wrapper.nextElementSibling.tagName)) {
        wrapper.appendChild(wrapper.nextElementSibling);
      }
      break;
    }
  }
</script>
