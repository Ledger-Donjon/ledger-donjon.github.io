---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  const includeDrafts = !import.meta.env.PROD;

  return entries
    .filter((entry) => includeDrafts || !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.md$/, '') },
      props: { entry },
    }));
}

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.date);
---

<Base title={entry.data.title} description={entry.data.excerpt} bodyClass="clean-bg">
  <article class="blog-post">
    <div class="container">
      <nav class="blog-post__nav">
        <a href={withBase('/blog/')} class="blog-post__back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          All posts
        </a>
      </nav>

      <header class="blog-post__header">
        <div class="blog-post__meta">
          <time class="blog-post__date" datetime={entry.data.date.toISOString()}>
            {formattedDate}
          </time>
          <span class="blog-post__separator" aria-hidden="true"></span>
          <span class="blog-post__label">Donjon blog</span>
        </div>
        <h1 class="blog-post__title">{entry.data.title}</h1>
        <p class="blog-post__excerpt" set:html={entry.data.excerpt} />
      </header>

      <div class="blog-post__body prose">
        <Content />
      </div>

      <footer class="blog-post__footer">
        <a href={withBase('/blog/')} class="blog-post__back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          Back to blog
        </a>
      </footer>
    </div>
  </article>

  <dialog class="lightbox" id="lightbox">
    <img class="lightbox__img" />
    <button class="lightbox__close" aria-label="Close lightbox">&times;</button>
  </dialog>
</Base>

<script>
  // Lightbox
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const dialogImg = dialog?.querySelector('.lightbox__img') as HTMLImageElement;
  const closeBtn = dialog?.querySelector('.lightbox__close') as HTMLButtonElement;

  document.querySelectorAll('.prose img').forEach((img) => {
    (img as HTMLElement).style.cursor = 'zoom-in';
    img.addEventListener('click', () => {
      dialogImg.src = (img as HTMLImageElement).src;
      dialogImg.alt = (img as HTMLImageElement).alt;
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Abstract section wrapper
  const prose = document.querySelector('.prose');
  if (prose) {
    const headings = prose.querySelectorAll('h2');
    for (const h2 of headings) {
      if (h2.textContent?.trim() !== 'Abstract') continue;
      const wrapper = document.createElement('section');
      wrapper.className = 'abstract';
      h2.before(wrapper);
      wrapper.appendChild(h2);
      while (wrapper.nextElementSibling && !/^H[1-6]$/.test(wrapper.nextElementSibling.tagName)) {
        wrapper.appendChild(wrapper.nextElementSibling);
      }
      break;
    }
  }
</script>

<style lang="scss">
  .blog-post {
    padding: var(--space-7) 0 var(--space-14);
  }

  .blog-post__nav {
    max-width: var(--max-width-prose);
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  .blog-post__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-tertiary);
    transition: color var(--transition-fast);

    &:hover {
      color: var(--color-accent-primary);
      text-decoration: none;
    }
  }

  .blog-post__header {
    max-width: var(--max-width-prose);
    margin-inline: auto;
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .blog-post__date {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-primary);
  }

  .blog-post__separator {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-text-tertiary);
  }

  .blog-post__label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .blog-post__title {
    font-size: var(--text-5xl);
    line-height: 1.15;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;

    @media (max-width: 768px) {
      font-size: var(--text-3xl);
    }
  }

  .blog-post__excerpt {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;

    :global(mark) {
      background: transparent;
      color: var(--color-accent-primary);
      font-weight: 600;
    }
  }

  .blog-post__body {
    max-width: var(--max-width-prose);
  }

  .blog-post__footer {
    max-width: var(--max-width-prose);
    margin-inline: auto;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .blog-post__back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);

    &:hover {
      color: var(--color-accent-primary);
      border-color: var(--color-accent-primary);
      text-decoration: none;
    }
  }
</style>

<style lang="scss" is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    padding: var(--space-6);
    overflow: hidden;

    &::backdrop {
      background: rgba(0, 0, 0, 0.88);
      backdrop-filter: blur(6px);
    }
  }

  .lightbox__img {
    display: block;
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: var(--radius-lg);
    border: none;
    box-shadow: none;
    mask-image: none;
    -webkit-mask-image: none;
  }

  .lightbox__close {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    z-index: 1;

    &:hover {
      color: var(--color-text-primary);
      background: rgba(255, 255, 255, 0.1);
    }
  }
</style>
