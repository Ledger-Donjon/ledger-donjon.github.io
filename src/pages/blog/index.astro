---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ResourceOverview from '../../components/ResourceOverview.astro';
import ResourceSectionHeader from '../../components/ResourceSectionHeader.astro';
import { getMergedDonjonBlogArticles } from '../../lib/donjon-blog';

const categoryUrl = 'https://www.ledger.com/blog/category/donjon';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;

const articles = await getMergedDonjonBlogArticles(withBase);
const recentCutoffMs = 90 * 24 * 60 * 60 * 1000;

const parseDate = (value: string | null) => {
  if (!value) return null;
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return null;
  return parsed;
};

const formatDateText = (value: string | null) => {
  const parsed = parseDate(value);
  if (!parsed) return '';
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(parsed);
};

const isRecentArticle = (value: string | null) => {
  const parsed = parseDate(value);
  if (!parsed) return false;
  const parsedMs = parsed.getTime();
  return Date.now() >= parsedMs && Date.now() - parsedMs < recentCutoffMs;
};

const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '');
---

<Base
  title="Our blog"
  description="Articles and security research from the Ledger Donjon team, with selected posts from the Ledger corporate blog."
>
  <Hero
    title="Our blog"
    subtitle="Articles and security research from the Ledger Donjon team."
    size="sm"
  />

  <section class="resource-page">
    <div class="container">
      <ResourceOverview>
        <p>
          Research notes, attack techniques, and technical findings from the Ledger Donjon team,
          published here and on the Ledger corporate blog.
        </p>
      </ResourceOverview>

      <section class="resource-section">
        <ResourceSectionHeader number="01" label="Publications" title="Latest research">
          <p>
            Browse recent Donjon work or subscribe to receive new on-site publications through RSS.
          </p>
        </ResourceSectionHeader>

        <div class="content__header">
          <a class="content__rss" href={withBase('/blog/rss.xml')}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
            </svg>
            Subscribe (RSS)
          </a>
          <a class="content__cta" href={categoryUrl} target="_blank" rel="noopener noreferrer">
            Ledger corporate blog
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 16L16 4M8 4h8v8" />
            </svg>
          </a>
        </div>

        {articles.length === 0 && (
          <div class="content__fallback">
            No Donjon articles are available yet. Please use the Ledger blog link above to browse the
            category if needed.
          </div>
        )}

        {articles.length > 0 && (
          <div class="articles">
            {articles.map((article) => {
              const isNew = isRecentArticle(article.date);
              const isExternal = article.openInNewTab;
              return (
                <article class="articles__card">
                  <a
                    href={article.href}
                    class="articles__link"
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                  >
                    <div class="articles__meta">
                      {article.date && (
                        <time class="articles__date" datetime={article.date}>
                          {formatDateText(article.date)}
                        </time>
                      )}
                      {isNew && <span class="articles__badge">New</span>}
                      {!isExternal && <span class="articles__badge articles__badge--local">Donjon</span>}
                    </div>
                    <h3 class="articles__title">{article.title}</h3>
                    {article.excerpt && <p class="articles__excerpt">{stripHtml(article.excerpt)}</p>}
                    <span
                      class="articles__cta"
                      aria-label={isExternal ? 'Opens on Ledger corporate blog' : 'Read on donjon.ledger.com'}
                    >
                      {isExternal ? (
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                          <path d="M4 16L16 4M8 4h8v8" />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                          <path d="M4 10h11M11 6l4 4-4 4" />
                        </svg>
                      )}
                    </span>
                  </a>
                </article>
              );
            })}
          </div>
        )}
      </section>
    </div>
  </section>
</Base>

<style lang="scss">
  .resource-page {
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .content__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-8);

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .content__rss {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 0.25rem var(--space-5);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-bg-primary);
    background: var(--color-accent-primary);
    border: 1px solid var(--color-accent-primary);
    border-radius: 0;
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: none;

    svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.5;
    }

    &:hover {
      background: var(--color-ledger-orange-hover);
      box-shadow: none;
      text-decoration: none;
      color: var(--color-bg-primary);
    }
  }

  .content__cta {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 0.25rem var(--space-5);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    font-weight: 500;
    text-decoration: none;

    svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: var(--color-accent-primary);
      stroke-width: 1.5;
      transition: transform var(--transition-fast);
    }

    &:hover {
      color: var(--color-text-primary);
      border-color: var(--color-accent-primary);
      text-decoration: none;
    }

    &:hover svg {
      transform: translateX(4px);
    }
  }

  .content__fallback {
    padding: var(--space-6);
    border-radius: 0;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  .articles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
    }
  }

  .articles__card {
    background: transparent;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent-primary);
    border-radius: 0;
    transition: all var(--transition-normal);
    position: relative;

    &:hover {
      border-color: var(--color-border-hover);
      border-top-color: var(--color-accent-primary);
      background: var(--color-bg-hover);
      box-shadow: none;
    }
  }

  .articles__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .articles__meta {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .articles__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
    background: transparent;
    border-radius: 0;
    padding: 0;
  }

  .articles__badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-bg-primary);
    background: var(--color-accent-primary);
    border: 1px solid var(--color-accent-primary);
    border-radius: 0;
    padding: var(--space-1) var(--space-2);
    box-shadow: none;

    &--local {
      background: var(--color-accent-glow);
      color: var(--color-accent-primary);
      border-color: var(--color-border);
      box-shadow: none;
    }
  }

  .articles__title {
    max-width: 28ch;
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin: 0;
    color: var(--color-text-primary);
  }

  .articles__excerpt {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .articles__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-end;
    margin-top: auto;
    color: var(--color-accent-primary);

    svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.5;
      transition: transform var(--transition-fast);
    }
  }

  .articles__card:hover .articles__cta svg {
    transform: translateX(4px);
  }
</style>
