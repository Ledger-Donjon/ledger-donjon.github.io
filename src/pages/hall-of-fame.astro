---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ResourceOverview from '../components/ResourceOverview.astro';
import ResourceSectionHeader from '../components/ResourceSectionHeader.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base}${path.replace(/^\/+/, '')}`;

const hallOfFame = [
  {
    year: 2025,
    researchers: [
      { name: 'Guanxing Wen', org: 'Certik', url: 'https://www.certik.com/' }
    ]
  },
  {
    year: 2022,
    researchers: [
      { name: 'Niv Yehezkel', org: 'Hexagate', url: 'https://www.hexagate.com/' }
    ]
  },
  {
    year: 2021,
    researchers: [
      { name: 'Timothée Isnard', org: 'Tanker', url: 'https://tanker.io' }
    ]
  },
  {
    year: 2020,
    researchers: [
      { name: 'Markus Alvila', org: 'Towo Labs', url: 'https://towolabs.com/' },
      { name: "Tal Be'ery", org: 'Zengo', url: 'https://zengo.com/' },
      { name: 'Dušan Klinec', org: null, url: null },
      { name: 'Kraken Security Labs', org: 'Kraken', url: 'https://www.kraken.com/' },
      { name: 'Sebastian Kung', org: null, url: null },
      { name: 'Oded Leiba', org: 'Zengo', url: 'https://zengo.com/' },
      { name: 'Saleem Rashid', org: null, url: null },
      { name: 'Patrik Sletmo', org: 'Towo Labs', url: 'https://towolabs.com/' }
    ]
  },
  {
    year: 2019,
    researchers: [
      { name: 'Peter Perešíni', org: 'Vacuumlabs', url: 'https://vacuumlabs.com/' },
      { name: 'Christian Reitter', org: null, url: null }
    ]
  },
  {
    year: 2018,
    researchers: [
      { name: 'Timothée Isnard', org: null, url: null },
      { name: 'Sergey Lappo', org: 'Mycelium', url: 'https://mycelium.com/' },
      { name: 'Saleem Rashid', org: null, url: null },
      { name: 'Sergei Volokitin', org: null, url: null }
    ]
  }
];
---

<Base title="Hall of Fame" description="Recognizing security researchers who have contributed to the security of Ledger products.">
  <Hero 
    title="Hall of Fame" 
    subtitle="Recognizing the security researchers who have helped make Ledger products more secure."
    size="sm" 
  />
  
  <section class="resource-page">
    <div class="container">
      <ResourceOverview>
        <p>
          Ledger thanks the security researchers who have contributed to the security of Ledger
          products through the Devices Bug Bounty program.
        </p>
      </ResourceOverview>

      <section class="resource-section">
        <ResourceSectionHeader number="01" label="Acknowledgements" title="Recognized researchers">
          <p>
            A record of responsible disclosures that helped make Ledger products more secure.
          </p>
        </ResourceSectionHeader>

        <div class="timeline">
          {hallOfFame.map((yearGroup) => (
            <div class="timeline-year">
              <div class="timeline-year__marker">
                <span class="timeline-year__label">{yearGroup.year}</span>
              </div>
              <div class="timeline-year__content">
                <ul class="researcher-list">
                  {yearGroup.researchers.map((researcher) => (
                    <li class="researcher">
                      <span class="researcher__name">{researcher.name}</span>
                      {researcher.org && (
                        <span class="researcher__org">
                          {researcher.url ? (
                            <a href={researcher.url} target="_blank" rel="noopener noreferrer">
                              {researcher.org}
                            </a>
                          ) : (
                            researcher.org
                          )}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <div class="cta-section">
          <div>
            <h2>Want to be featured here?</h2>
            <p>
              Discover vulnerabilities in Ledger products and get recognized for your contribution
              to the security of the crypto ecosystem.
            </p>
          </div>
          <a href={withBase('/bounty/')} class="btn-primary">
            Join the Bug Bounty Program
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>
      </section>
    </div>
  </section>
</Base>

<style lang="scss">
  .resource-page {
    padding: clamp(4rem, 8vw, 7rem) 0;
  }
  
  .timeline {
    position: relative;
    max-width: 800px;
    
    &::before {
      content: '';
      position: absolute;
      left: 60px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--color-border);
      
      @media (max-width: 640px) {
        left: 30px;
      }
    }
  }
  
  .timeline-year {
    display: flex;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
    
    @media (max-width: 640px) {
      gap: var(--space-6);
    }
    
    &__marker {
      flex-shrink: 0;
      width: 120px;
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
      padding-right: var(--space-6);
      position: relative;
      
      @media (max-width: 640px) {
        width: 60px;
        padding-right: var(--space-4);

        &::after {
          left: 30px;
        }
      }
      
      &::after {
        content: '';
        position: absolute;
        left: 60px;
        top: 8px;
        width: 12px;
        height: 12px;
        background: var(--color-bg-primary);
        border: 2px solid var(--color-accent-primary);
        border-radius: 0;
        transform: translateX(-50%);
      }
    }
    
    &__label {
      display: inline-block;
      font-size: var(--text-xl);
      font-weight: 700;
      color: var(--color-accent-primary);
      font-family: var(--font-mono);
      transform: translateX(25px);
    }
    
    &__content {
      flex: 1;
      padding-top: var(--space-1);
    }
  }
  
  .researcher-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .researcher {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-accent-primary);
    border-radius: 0;
    transition: all var(--transition-fast);
    
    &:hover {
      border-color: var(--color-border-hover);
      border-left-color: var(--color-accent-primary);
      background: var(--color-bg-hover);
    }
    
    &__name {
      font-weight: 500;
      color: var(--color-text-primary);
    }
    
    &__org {
      font-size: var(--text-sm);
      color: var(--color-text-tertiary);
      
      a {
        color: var(--color-text-secondary);
        
        &:hover {
          color: var(--color-accent-primary);
        }
      }
      
      &::before {
        content: '·';
        margin-right: var(--space-3);
      }
    }
  }
  
  .cta-section {
    margin-top: var(--space-16);
    padding: var(--space-10);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-8);
    background: transparent;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent-primary);
    border-radius: 0;
    max-width: 800px;
    
    h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 500;
      letter-spacing: -0.04em;
      margin-bottom: var(--space-3);
    }
    
    p {
      max-width: 34rem;
      color: var(--color-text-secondary);
      margin: 0;
    }
  }
  
  .btn-primary {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.25rem var(--space-5);
    background: var(--color-ledger-orange);
    color: var(--color-bg-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0;
    transition: all var(--transition-fast);
    text-decoration: none;

    svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentcolor;
      stroke-width: 1.5;
      transition: transform var(--transition-fast);
    }
    
    &:hover {
      background: var(--color-ledger-orange-hover);
      color: var(--color-bg-primary);
      text-decoration: none;

      svg {
        transform: translateX(0.2rem);
      }
    }
  }

  @media (max-width: 720px) {
    .cta-section {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      padding: var(--space-6);
    }

    .btn-primary {
      justify-self: start;
    }
  }

  @media (max-width: 480px) {
    .btn-primary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
