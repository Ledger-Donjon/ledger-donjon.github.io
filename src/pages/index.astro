---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getMergedDonjonBlogArticles } from '../lib/donjon-blog';
import { withBase } from '../lib/url';

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

const formatDate = (date: Date) => {
  const parts = Object.fromEntries(
    dateFormatter.formatToParts(date).map((part) => [part.type, part.value]),
  );
  return `${parts.day} ${parts.month.replace('.', '').slice(0, 3)} ${parts.year}`;
};

const parseBulletinDate = (body: string) => {
  const firstLine = body
    .split('\n')
    .map((line) => line.trim())
    .find((line) => line.length > 0);
  const match = firstLine?.match(/^(\d{1,2}\s+[A-Za-z]+\s+\d{4})/);
  if (!match) return null;
  const parsed = new Date(match[1]);
  if (Number.isNaN(parsed.getTime())) return null;
  // Normalise to UTC midnight so the datetime attribute matches the visible date.
  return new Date(Date.UTC(parsed.getFullYear(), parsed.getMonth(), parsed.getDate()));
};

const latestBulletins = (await getCollection('lsb'))
  .map((bulletin) => {
    const number = bulletin.id;
    return {
      ref: `LSB ${number}`,
      title: bulletin.data.summary || bulletin.data.title,
      href: withBase(`/lsb/${number}/`),
      date: parseBulletinDate(bulletin.body ?? ''),
      number: parseInt(number, 10),
    };
  })
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0) || b.number - a.number)
  .slice(0, 5);

const latestArticles = (await getMergedDonjonBlogArticles())
  .map((article) => ({
    title: article.title,
    href: article.href,
    date: article.date ? new Date(article.date) : null,
    external: article.openInNewTab,
  }))
  .slice(0, 5);

const directory = [
  {
    href: withBase('/lsb/'),
    title: 'Security Bulletins',
    description:
      'Technical write-ups of past security issues affecting Ledger products, their impact, and the versions that fix them.',
  },
  {
    href: withBase('/threat-model/'),
    title: 'Threat Model',
    description:
      'The security objectives of Ledger devices, the attackers they are designed to resist, and the mechanisms that enforce them.',
  },
  {
    href: withBase('/tools-suite/'),
    title: 'Tools Suite',
    description:
      'Open-source security research tools for hardware and software analysis.',
  },
  {
    href: withBase('/about/'),
    title: 'About the Team',
    description:
      'Who we are, how we work with vendors on coordinated disclosure, and how to get in touch with us.',
  },
];
---

<Base
  title="Home"
  description="The security research team at Ledger. Protecting your crypto assets through cutting-edge security research."
>
  <div class="lab-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__grid">
        <div class="hero__copy">
          <h1 id="hero-title" class="hero__title">
            <span class="hero__donjon">Donjon</span><br />
            <span class="hero__ledger">@ Ledger</span>
          </h1>

          <p class="hero__lede">
            We are the security research team at Ledger, dedicated to protecting your digital
            assets through cutting-edge security research, vulnerability discovery, and open-source
            tools.
          </p>

          <div class="hero__actions">
            <a href={withBase('/blog/')} class="action action--solid">
              Read the Blog
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
          </div>
        </div>

        <div class="hero__brand-mark" aria-hidden="true">
          <img
            src={withBase('/img/donjon-shield-static.gif')}
            alt=""
            width="240"
            height="300"
          />
        </div>
      </div>

      <aside class="disclose" aria-labelledby="disclose-title">
        <div class="container disclose__inner">
          <div class="disclose__content">
            <h2 id="disclose-title">Found a vulnerability?</h2>

            <div class="disclose__copy">
              <p>
                We reward security researchers who help us protect our users. Join our bug bounty
                program and get recognized in our Hall of Fame.
              </p>
            </div>

            <div class="disclose__actions">
              <a class="action action--outline disclose__report" href={withBase('/bounty/')}>
                Report a vulnerability
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h11M11 6l4 4-4 4" />
                </svg>
              </a>
              <a class="disclose__honours" href={withBase('/hall-of-fame/')}>Hall of Fame →</a>
            </div>
          </div>
        </div>
      </aside>

      <div class="hero__rail">
        <div class="container hero__rail-inner">
          <a href="#work" class="hero__scroll">
            Discover our work
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 3v13M6 12l4 4 4-4" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section id="work" class="section archive">
      <div class="container">
        <div class="section-heading section-heading--solo">
          <h2>Discover our work</h2>
        </div>

        <ol class="directory">
          {directory.map((item) => (
            <li>
              <a class="case-file" href={item.href}>
                <div class="case-file__body">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <span class="case-file__open">
                  Explore
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section field-log">
      <div class="container">
        <div class="section-heading section-heading--solo section-heading--log">
          <h2>Latest Publications</h2>
        </div>

        <div class="logs">
          <article class="log">
            <header class="log__header">
              <h3>Blog</h3>
              <a href={withBase('/blog/')} class="micro-link">All blog posts <span>→</span></a>
            </header>

            {latestArticles.length === 0 ? (
              <p class="log__empty">No blog posts are available yet.</p>
            ) : (
              <ol class="log__entries">
                {latestArticles.map((entry) => (
                  <li>
                    <a
                      href={entry.href}
                      target={entry.external ? '_blank' : undefined}
                      rel={entry.external ? 'noopener noreferrer' : undefined}
                    >
                      <time datetime={entry.date?.toISOString()}>
                        {entry.date ? formatDate(entry.date) : '—'}
                      </time>
                      <span class="log__title">
                        {entry.title}
                        {entry.external && <span class="log__external" aria-hidden="true">↗</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </article>

          <article class="log log--bulletins">
            <header class="log__header">
              <h3>Security Bulletins</h3>
              <a href={withBase('/lsb/')} class="micro-link">All security bulletins <span>→</span></a>
            </header>

            {latestBulletins.length === 0 ? (
              <p class="log__empty">No security bulletins are available yet.</p>
            ) : (
              <ol class="log__entries">
                {latestBulletins.map((entry) => (
                  <li>
                    <a href={entry.href}>
                      <time datetime={entry.date?.toISOString()}>
                        {entry.date ? formatDate(entry.date) : '—'}
                      </time>
                      <span class="log__ref">{entry.ref}</span>
                      <span class="log__title">{entry.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </article>
        </div>
      </div>
    </section>
  </div>
</Base>

<style lang="scss">
  .lab-page {
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
  }

  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    min-height: calc(100svh - var(--header-height));
    display: flex;
    flex-direction: column;
    background: var(--color-bg-primary);

    &__grid {
      position: relative;
      z-index: 1;
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(390px, 0.74fr);
      align-items: center;
      gap: clamp(2.5rem, 5vw, 6rem);
      padding-top: clamp(3.25rem, 6vh, 5rem);
      padding-bottom: clamp(3.25rem, 6vh, 5rem);
    }

    &__copy {
      max-width: 830px;
      animation: hero-enter 700ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
    }

    &__title {
      max-width: 8ch;
      margin: 0;
      font-size: clamp(4rem, 7.5vw, 8.6rem);
      font-weight: 500;
      letter-spacing: -0.07em;
      line-height: 0.88;
      text-wrap: balance;
      color: var(--color-text-primary);

      .hero__donjon {
        color: var(--color-accent-primary);
      }

      .hero__ledger {
        color: var(--color-text-primary);
      }
    }

    &__lede {
      max-width: 43rem;
      margin: clamp(1.75rem, 4vh, 2.75rem) 0 0;
      font-size: clamp(1.08rem, 1.45vw, 1.35rem);
      line-height: 1.55;
      color: var(--color-text-lede);
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    &__rail {
      position: relative;
      z-index: 2;
      background: var(--color-bg-primary);
    }

    &__rail-inner {
      min-height: 4.5rem;
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    &__scroll {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      text-decoration: none;

      svg {
        width: 1rem;
        height: 1rem;
        stroke: var(--color-accent-primary);
        stroke-width: 1.5;
      }

      &:hover {
        color: var(--color-text-primary);
        text-decoration: none;
      }
    }
  }

  .disclose {
    position: relative;
    z-index: 2;
    background: var(--color-bg-primary);

    &__inner {
      padding-block: clamp(1.75rem, 3vw, 3rem);
    }

    &__content {
      display: grid;
      grid-template-columns: minmax(15rem, 0.75fr) minmax(22rem, 1fr) auto;
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);

      h2 {
        max-width: 9ch;
        margin: 0;
        font-size: clamp(2rem, 3.5vw, 3.6rem);
        font-weight: 500;
        letter-spacing: -0.045em;
        line-height: 1;
      }
    }

    &__copy {
      padding-left: clamp(1.5rem, 3vw, 3rem);
      border-left: 1px solid var(--color-border);

      p {
        max-width: 48ch;
        margin: 0;
        font-size: 0.9rem;
        font-weight: 500;
        line-height: 1.45;
        color: var(--color-text-lede);
      }
    }

    &__actions {
      display: grid;
      justify-items: start;
      gap: 0.75rem;
    }

    &__report {
      white-space: nowrap;
    }

    &__honours {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      text-decoration: none;

      &:hover {
        color: var(--color-text-primary);
        text-decoration: none;
      }
    }
  }

  .hero__brand-mark {
    width: min(100%, 28rem);
    justify-self: end;
    display: grid;
    place-items: center;
    animation: brand-enter 850ms 120ms cubic-bezier(0.2, 0.75, 0.25, 1) both;

    img {
      display: block;
      width: clamp(11rem, 21vw, 16rem);
      height: auto;
      border-radius: 0;
    }
  }

  .section {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    scroll-margin-top: var(--header-height);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.45fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: clamp(2.5rem, 4vw, 3.75rem);

    h2 {
      margin: 0;
      font-size: clamp(3rem, 6.5vw, 7.5rem);
      font-weight: 500;
      letter-spacing: -0.065em;
      line-height: 0.95;
    }

    p {
      max-width: 31rem;
      margin: 0;
      font-size: 1rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
    }

    &--solo {
      grid-template-columns: minmax(0, 1fr);
    }

    &--log {
      h2 {
        font-size: clamp(3rem, 5.2vw, 6rem);
      }
    }
  }

  .archive {
    background: var(--color-bg-primary);
  }

  .directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;

    > li {
      margin: 0;
      border-bottom: 1px solid var(--color-border);

      &:nth-child(odd) {
        border-right: 1px solid var(--color-border);
      }
    }
  }

  .case-file {
    position: relative;
    min-height: 17.5rem;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: background 250ms ease;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 3px;
      background: var(--color-accent-primary);
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform 250ms ease;
    }

    &:hover {
      background: var(--color-bg-hover);
      color: inherit;
      text-decoration: none;

      &::before {
        transform: scaleY(1);
      }

      .case-file__open svg {
        transform: translateX(0.3rem);
      }
    }

    &:focus-visible {
      outline: 2px solid var(--color-accent-primary);
      outline-offset: -2px;
    }

    h3 {
      margin: 0;
      font-size: clamp(2rem, 3.4vw, 3.8rem);
      font-weight: 500;
      letter-spacing: -0.05em;
    }

    p {
      max-width: 30rem;
      margin: 1.25rem 0 0;
      font-size: 0.95rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
    }

    &__open {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      margin-top: 2rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-primary);

      svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: var(--color-accent-primary);
        stroke-width: 1.5;
        transition: transform 180ms ease;
      }
    }
  }

  .field-log {
    background: var(--color-bg-primary);
  }

  .logs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
  }

  .log {
    border-top: 2px solid var(--color-accent-primary);

    &--bulletins {
      border-top-color: var(--color-text-secondary);

      .log__entries a {
        grid-template-columns: 7rem 5rem minmax(0, 1fr);
      }
    }

    &__header {
      min-height: 6.5rem;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.25rem 0 2rem;
      border-bottom: 1px solid var(--color-border);

      h3 {
        margin: 0;
        font-size: clamp(1.45rem, 2vw, 2rem);
        font-weight: 500;
        letter-spacing: -0.03em;
      }
    }

    &__entries {
      margin: 0;
      padding: 0;
      list-style: none;

      li {
        margin: 0;
        border-bottom: 1px solid var(--color-border);
      }

      a {
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr);
        gap: 1rem;
        align-items: baseline;
        min-height: 5.5rem;
        padding: 1.25rem 0;
        color: inherit;
        text-decoration: none;

        &:hover {
          color: inherit;
          text-decoration: none;
          background: var(--color-bg-hover);

          .log__title {
            color: var(--color-accent-primary);
          }
        }

        &:focus-visible {
          outline: 2px solid var(--color-accent-primary);
          outline-offset: -2px;
        }
      }

      time {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        white-space: nowrap;
        color: var(--color-text-tertiary);
      }
    }

    &__ref {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      white-space: nowrap;
      color: var(--color-accent-primary);
    }

    &__title {
      max-width: 38rem;
      font-size: 0.95rem;
      font-weight: 500;
      line-height: 1.45;
      color: var(--color-text-lede);
      transition: color 180ms ease;
    }

    &__external {
      margin-left: 0.35rem;
      font-family: var(--font-mono);
      color: var(--color-text-tertiary);
    }

    &__empty {
      margin: 0;
      padding: 2rem 0;
      color: var(--color-text-secondary);
    }
  }

  .micro-link {
    flex: 0 0 auto;
    padding-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;

    span {
      color: var(--color-accent-primary);
    }

    &:hover {
      color: var(--color-text-primary);
      text-decoration: none;
    }
  }

  @keyframes brand-enter {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 1100px) {
    .hero {
      &__grid {
        grid-template-columns: minmax(0, 1fr) minmax(330px, 0.72fr);
        gap: 3rem;
      }

      &__title {
        font-size: clamp(4rem, 7.7vw, 6.5rem);
      }
    }

    .disclose {
      &__content {
        grid-template-columns: minmax(13rem, 0.55fr) minmax(0, 1fr);
        gap: 1.25rem 2rem;
      }

      &__actions {
        grid-column: 2;
        display: flex;
        align-items: center;
      }
    }
  }

  @media (max-width: 900px) {
    .hero {
      &__grid {
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: clamp(1.5rem, 4vw, 3rem);
        padding-block: 3.25rem;
      }

      &__copy {
        max-width: 760px;
      }

      &__title {
        font-size: clamp(4rem, 13vw, 7.5rem);
      }

      &__lede {
        max-width: 38rem;
      }

      &__rail-inner {
        overflow-x: auto;
      }
    }

    .hero__brand-mark {
      display: grid;
      width: auto;
      justify-self: end;
      place-items: end;
      margin-top: -0.75rem;

      img {
        width: clamp(8rem, 20vw, 11rem);
      }
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
    }

    .section-heading p {
      max-width: 40rem;
    }

    .case-file {
      min-height: 16.5rem;
    }
  }

  @media (max-width: 720px) {
    .hero {
      &__grid {
        padding-top: 2.75rem;
      }

      &__title {
        font-size: clamp(3.45rem, 16vw, 5.6rem);
        letter-spacing: -0.075em;
      }

      &__lede {
        font-size: 1rem;
      }

      &__rail-inner {
        min-height: 3.8rem;
      }
    }

    .hero__brand-mark {
      margin-top: -1rem;

      img {
        width: clamp(7rem, 30vw, 9rem);
      }
    }

    .disclose {
      &__content {
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
      }

      &__copy {
        padding-top: 1.25rem;
        padding-left: 0;
        border-top: 1px solid var(--color-border);
        border-left: 0;
      }

      &__actions {
        grid-column: 1;
      }
    }

    .section {
      padding-block: 4rem;
    }

    .directory {
      grid-template-columns: 1fr;

      > li:nth-child(odd) {
        border-right: 0;
      }
    }

    .case-file {
      min-height: 15.5rem;
    }

    .logs {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      &__actions {
        align-items: stretch;
      }
    }

    .disclose__actions {
      display: grid;
      justify-items: stretch;
    }

    .case-file {
      padding-inline: 0;

      h3 {
        font-size: 2rem;
      }
    }

    .log {
      &__header {
        gap: 1rem;
      }

      &__entries a {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
      }

      &--bulletins .log__entries a {
        grid-template-columns: auto minmax(0, 1fr);
      }

      &--bulletins .log__title {
        grid-column: 1 / -1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy,
    .hero__brand-mark {
      animation: none;
    }
  }
</style>
