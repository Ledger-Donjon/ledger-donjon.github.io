---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base}${path.replace(/^\/+/, '')}`;

const focusAreas = [
  {
    title: 'Protect the product',
    description: 'Evaluate Ledger devices and software before weaknesses can affect users.',
  },
  {
    title: 'Strengthen the ecosystem',
    description: 'Apply our research beyond Ledger when it can improve security across the industry.',
  },
  {
    title: 'Share what helps',
    description: 'Publish research and release attack tooling that moves the security community forward.',
  },
];

const expertise = [
  {
    title: 'Software Security',
    description:
      'We study firmware and applications from source code to machine code, looking for the paths an attacker would take.',
    disciplines: ['Firmware analysis', 'Reverse engineering', 'Vulnerability research'],
  },
  {
    title: 'Hardware Security',
    description:
      'We evaluate devices at the physical layer, where implementation details become observable and exploitable.',
    disciplines: ['Side-channel analysis', 'Fault injection', 'Chip-level assessment'],
  },
  {
    title: 'Cryptography',
    description:
      'We assess protocols and implementations to make sure strong primitives remain strong in real products.',
    disciplines: ['Protocol analysis', 'Implementation review', 'Algorithm assessment'],
  },
];
---

<Base title="About" description="Ledger Donjon is the security research team at Ledger. Learn about our mission and expertise.">
  <Hero
    title="Inside the Donjon"
    subtitle="The security research team at Ledger, working across software, hardware, and cryptography."
    size="sm"
  />

  <section class="about-section mission">
    <div class="container">
      <div class="mission__intro">
        <h2>We make Ledger products harder to break.</h2>
        <div class="mission__copy">
          <p>
            The Donjon's core mission is to improve the security of Ledger products through
            hands-on, attacker-minded research.
          </p>
          <p>
            We also contribute to the wider security ecosystem and undertake selected external
            security audits and consultancy.
          </p>
        </div>
      </div>

      <div class="focus-grid">
        {focusAreas.map((area) => (
          <article class="focus">
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section capabilities">
    <div class="container">
      <div class="capabilities__intro">
        <h2>From source code to silicon.</h2>
        <p>
          Product security crosses boundaries. Our work combines disciplines so an issue cannot
          hide in the gap between software, electronics, and cryptography.
        </p>
      </div>

      <div class="expertise-grid">
        {expertise.map((area) => (
          <article class="expertise">
            <div class="expertise__body">
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </div>
            <ul class="expertise__disciplines" aria-label={`${area.title} disciplines`}>
              {area.disciplines.map((discipline) => <li>{discipline}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section open-source">
    <div class="container">
      <div class="open-source__content">
        <h2>Tools should travel further than the lab.</h2>
        <div class="open-source__copy">
          <p>
            We release much of our internal attack tooling so other researchers can reproduce,
            improve, and build on our work.
          </p>
          <div class="open-source__actions">
            <a href={withBase('/tools-suite/')} class="action action--solid">
              Explore the tools
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
            <a
              href="https://github.com/ledger-donjon"
              class="action action--line"
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 16L16 4M8 4h8v8" />
              </svg>
            </a>
          </div>
          <span class="open-source__note">Pull requests are welcome.</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style lang="scss">
  .about-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    scroll-margin-top: var(--header-height, 72px);
  }

  .mission__intro,
  .capabilities__intro,
  .open-source__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);

    h2 {
      max-width: 11ch;
      margin: 0;
      font-size: clamp(3rem, 6.5vw, 7rem);
      font-weight: 500;
      letter-spacing: -0.065em;
      line-height: 0.95;
    }
  }

  .mission__copy,
  .open-source__copy {
    padding-left: clamp(1.5rem, 3vw, 3rem);
    border-left: 1px solid var(--color-border);

    p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.65;
      color: var(--color-text-secondary);

      + p {
        margin-top: var(--space-4);
      }
    }
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--color-border);
  }

  .focus {
    min-height: 14rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-normal);

    &:not(:last-child) {
      border-right: 1px solid var(--color-border);
    }

    &:hover {
      background: var(--color-bg-hover);
    }

    h3 {
      max-width: 12ch;
      margin: 0 0 var(--space-3);
      font-size: clamp(1.5rem, 2.5vw, 2.25rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.1;
    }

    p {
      max-width: 29rem;
      margin: 0;
      font-size: var(--text-sm);
      line-height: 1.6;
      color: var(--color-text-secondary);
    }
  }

  .capabilities__intro {
    margin-bottom: clamp(3.5rem, 7vw, 6rem);

    p {
      max-width: 34rem;
      margin: 0;
      padding-left: clamp(1.5rem, 3vw, 3rem);
      border-left: 1px solid var(--color-border);
      font-size: 1rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
    }
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid var(--color-accent-primary);
  }

  .expertise {
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: transparent;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-normal);

    &:not(:last-child) {
      border-right: 1px solid var(--color-border);
    }

    &:hover {
      background: var(--color-bg-hover);
    }
  }

  .expertise__body {
    h3 {
      margin: 0;
      font-size: clamp(1.8rem, 3vw, 3rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1.05;
    }

    p {
      max-width: 31rem;
      margin: var(--space-4) 0 0;
      font-size: 0.95rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
    }
  }

  .expertise__disciplines {
    margin: auto 0 0;
    padding: var(--space-6) 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;

    li {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.04em;
      color: var(--color-text-tertiary);

      + li {
        margin-top: var(--space-2);
      }

      &::before {
        content: '—';
        color: var(--color-accent-primary);
      }
    }
  }

  .open-source__content {
    align-items: center;
  }

  .open-source__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .open-source__note {
    display: block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 900px) {
    .mission__intro,
    .capabilities__intro,
    .open-source__content {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--space-8);
    }

    .mission__copy,
    .open-source__copy {
      max-width: 44rem;
    }

    .expertise-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .expertise {
      min-height: 20rem;

      &:not(:last-child) {
        border-right: 0;
      }
    }
  }

  @media (max-width: 720px) {
    .focus-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .focus {
      min-height: 12rem;

      &:not(:last-child) {
        border-right: 0;
      }
    }

    .mission__copy,
    .capabilities__intro p,
    .open-source__copy {
      padding-top: var(--space-6);
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }
</style>
