---
import Base from '../../layouts/Base.astro';
import DetailPageLayout from '../../components/DetailPageLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('threat-model');
  return pages
    .filter(page => !page.id.endsWith('.png'))
    .map((page) => ({
      params: { slug: page.id.replace('.md', '') },
      props: { page },
    }));
}

const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base}${path.replace(/^\/+/, '')}`;
const { page } = Astro.props;
const { Content } = await render(page);
---

<Base 
  title={`${page.data.title} - Threat Model`}
  description={`${page.data.title} - Ledger Devices Threat Model`}
>
  <DetailPageLayout
    title={page.data.title}
    backHref={withBase('/threat-model/#security-mechanisms')}
    backLabel="All security mechanisms"
  >
    <Fragment slot="meta">
      <span class="detail-tag">Threat model</span>
    </Fragment>

    <Content />

    <Fragment slot="footer">
      <a href={withBase('/threat-model/#security-mechanisms')} class="detail-action">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16 10H5M9 6l-4 4 4 4" />
        </svg>
        All security mechanisms
      </a>
    </Fragment>
  </DetailPageLayout>
</Base>
