---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ResourceOverview from '../../components/ResourceOverview.astro';
import ResourceSectionHeader from '../../components/ResourceSectionHeader.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';

const allLsb = await getCollection('lsb');
const datePattern = /^\s*(\d{1,2} [A-Za-z]+ \d{4})/m;
const bulletins = allLsb
  .map((bulletin) => {
    const { id } = bulletin;
    const date = (bulletin.body ?? '').match(datePattern)?.[1] ?? '';
    return { bulletin, id, date };
  })
  .sort((a, b) => parseInt(b.id, 10) - parseInt(a.id, 10));
---

<Base 
  title="Security Bulletins" 
  description="Technical details of past security issues, their potential impact and available patches or workarounds."
>
  <Hero 
    title="Ledger Security Bulletins" 
    subtitle="Technical details of past security issues, their potential impact and available patches or workarounds."
    size="sm"
  />
  
  <section class="resource-page">
    <div class="container">
      <ResourceOverview>
        <p>
          Ledger believes in better security through openness. If you believe that you have
          discovered a vulnerability, please report it through the
          <a href={withBase('/bounty/')}>bug bounty program</a>.
        </p>
      </ResourceOverview>

      <section class="resource-section">
        <ResourceSectionHeader title="Ledger security bulletins">
          <p>
            Browse technical details of past security issues, their potential impact, and the
            patches or workarounds available.
          </p>
        </ResourceSectionHeader>

        <div class="bulletins-table">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              {bulletins.map(({ bulletin, id, date }) => {
                return (
                  <tr>
                    <td>
                      <span class="bulletin-id">LSB {id}</span>
                    </td>
                    <td>
                      <a href={withBase(`/lsb/${id}/`)} class="bulletin-link">
                        {bulletin.data.title}
                        {bulletin.data.summary && (
                          <span class="bulletin-summary">{bulletin.data.summary}</span>
                        )}
                      </a>
                    </td>
                    <td>
                      {date && <time class="bulletin-date">{date}</time>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <p class="note">
          Note: these security bulletins are inspired by
          <a href="https://www.qubes-os.org/security/bulletins/" target="_blank" rel="noopener">
            Qubes Security Bulletins
          </a>
          but aren't related in any way.
        </p>
      </section>
    </div>
  </section>
</Base>

<style lang="scss">
  .resource-page {
    padding: clamp(4rem, 8vw, 7rem) 0;
  }
  
  .bulletins-table {
    background: transparent;
    border-top: 2px solid var(--color-accent-primary);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    overflow-x: auto;
    
    table {
      margin: 0;
    }
    
    th {
      text-align: left;
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-tertiary);
      background: transparent;
      
      &:first-child {
        width: 120px;
      }
      
      &:last-child {
        width: 160px;
      }
    }
    
    td {
      vertical-align: top;
    }
    
    tr:hover td {
      background: var(--color-bg-hover);
    }
  }
  
  .bulletin-id {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--color-accent-primary);
    background: transparent;
    border-radius: 0;
  }
  
  .bulletin-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-text-primary);
    font-size: 1.05rem;
    font-weight: 500;
    
    &:hover {
      color: var(--color-accent-primary);
      text-decoration: none;
    }
  }
  
  .bulletin-summary {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  .bulletin-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  
  .note {
    margin-top: var(--space-10);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  /* Stack each bulletin so the title gets the full width instead of a squeezed column */
  @media (max-width: 640px) {
    .bulletins-table {
      overflow-x: visible;

      table,
      tbody {
        display: block;
      }

      thead {
        display: none;
      }

      tr {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-areas:
          'id date'
          'title title';
        align-items: baseline;
        gap: var(--space-2) var(--space-3);
        padding: var(--space-4) 0;
        border-bottom: 1px solid var(--color-border);

        &:last-child {
          border-bottom: 0;
        }
      }

      td {
        padding: 0;
        border-bottom: 0;

        &:nth-child(1) {
          grid-area: id;
        }

        &:nth-child(2) {
          grid-area: title;
        }

        &:nth-child(3) {
          grid-area: date;
          justify-self: end;
        }
      }

      tr:hover td {
        background: transparent;
      }
    }

    .bulletin-id {
      padding: 0;
    }

    .bulletin-link {
      line-height: 1.35;
    }
  }
</style>
