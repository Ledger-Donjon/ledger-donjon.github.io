---
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ARTICLE_THEME_STORAGE_KEY } from '../lib/article-theme';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  enableArticleTheme?: boolean;
}

const { 
  title, 
  description = 'Security research at Ledger. The whispers from the Donjon.',
  image = withBase('/ledgerdonjon_banner.png'),
  bodyClass,
  enableArticleTheme = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
// The default banner is a small wide logo, which large-image cards would crop
// and upscale; only pages with their own image get the large card.
const twitterCard = Astro.props.image ? 'summary_large_image' : 'summary';
---

<!DOCTYPE html>
<html lang="en" data-article-theme={enableArticleTheme ? 'dark' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ storageKey: ARTICLE_THEME_STORAGE_KEY }}>
      (() => {
        const root = document.documentElement;
        if (!root.hasAttribute('data-article-theme')) return;

        try {
          if (localStorage.getItem(storageKey) === 'light') {
            root.dataset.articleTheme = 'light';
          }
        } catch {
          // Keep the dark default when storage is unavailable.
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content={enableArticleTheme ? 'dark light' : 'dark'} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Ledger Donjon Blog" href={withBase('/blog/rss.xml')} />
    
    <title>{title} | Ledger Donjon</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Ledger Donjon`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content="@donjonledger" />
    <meta name="twitter:title" content={`${title} | Ledger Donjon`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    
    <!-- Preconnect to font providers -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class={bodyClass}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 200px);
  }
</style>
